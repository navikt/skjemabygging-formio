{
  "name": "@navikt/fyllut-frontend",
  "homepage": "/fyllut",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "start": "cross-env NODE_ENV=development vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check-types": "tsc && tsc --project playwright/tsconfig.json",
    "clean": "rimraf dist coverage node_modules .runtime .cypress-home cypress/screenshots cypress/downloads",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "cypress": "cypress run",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.20.0",
    "@navikt/ds-css": "^8.20.0",
    "@navikt/ds-react": "^8.20.0",
    "@navikt/skjemadigitalisering-shared-components": "workspace:*",
    "@navikt/skjemadigitalisering-shared-frontend": "workspace:*",
    "@navikt/skjemadigitalisering-shared-domain": "workspace:*",
    "axe-core": "^4.14.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "chai": "^6.3.0",
    "cypress": "^16.2.1",
    "cypress-axe": "^1.7.0",
    "lodash": "^4.18.1",
    "lodash.template": "^4.18.1",
    "moment": "^2.31.0",
    "prop-types": "^15.8.1",
    "vitest-fetch-mock": "^0.4.5"
  }
}
