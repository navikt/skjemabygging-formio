{
  "name": "@navikt/sendinn-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Send inn, serving the sendinn SPA under /sendinn",
  "main": "dist/server.mjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "start": "cross-env NODE_ENV=development vite",
