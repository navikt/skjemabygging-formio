    "csp-header": "^6.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html-react-parser": "^5.2.15",
    "jsdom": "^29.1.1",
    "mustache-express": "^1.3.2",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mustache-express": "^1.2.5",
    "@types/node": "^24.6.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "vite-plugin-node": "^7.0.0"
